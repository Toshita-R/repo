{
  "datasets": [
    {
      "name": "5502dea6",
      "displayName": "gmv_total",
      "queryLines": [
        "SELECT ROUND(SUM(gross_revenue), 2) AS total_gmv\r\n",
        "FROM ecom_dev.gold.fct_order_items;"
      ]
    },
    {
      "name": "68745aaa",
      "displayName": "ontime_rate",
      "queryLines": [
        "SELECT ROUND(100.0 * AVG(CASE WHEN is_late_delivery THEN 0.0 ELSE 1.0 END), 1) AS ontime_pct\r\n",
        "FROM ecom_dev.gold.fct_order_items\r\n",
        "WHERE is_late_delivery IS NOT NULL;"
      ]
    },
    {
      "name": "4eebf9fd",
      "displayName": "monthly_revenue",
      "queryLines": [
        "SELECT year_month, orders, gmv, avg_order_value, repeat_customer_pct\r\n",
        "FROM ecom_dev.gold.mart_monthly_revenue\r\n",
        "WHERE orders > 100\r\n",
        "ORDER BY year_month;"
      ]
    },
    {
      "name": "f59fac00",
      "displayName": "delay_vs_score",
      "queryLines": [
        "SELECT\r\n",
        "  CASE\r\n",
        "    WHEN f.delivery_delay_days <= -7 THEN '7+ days early'\r\n",
        "    WHEN f.delivery_delay_days <  0  THEN 'Early'\r\n",
        "    WHEN f.delivery_delay_days =  0  THEN 'On the day'\r\n",
        "    WHEN f.delivery_delay_days <= 7  THEN '1-7 days late'\r\n",
        "    WHEN f.delivery_delay_days <= 14 THEN '8-14 days late'\r\n",
        "    ELSE '15+ days late'\r\n",
        "  END AS delay_bucket,\r\n",
        "  MIN(f.delivery_delay_days)   AS sort_key,\r\n",
        "  COUNT(DISTINCT f.order_id)   AS orders,\r\n",
        "  ROUND(AVG(r.review_score),2) AS avg_score\r\n",
        "FROM ecom_dev.gold.fct_order_items f\r\n",
        "JOIN ecom_dev.gold.fct_reviews r ON f.order_id = r.order_id\r\n",
        "WHERE f.delivery_delay_days IS NOT NULL\r\n",
        "GROUP BY 1\r\n",
        "ORDER BY sort_key;"
      ]
    },
    {
      "name": "925d2c7a",
      "displayName": "revenue_by_state",
      "queryLines": [
        "SELECT c.customer_state,\r\n",
        "       COUNT(DISTINCT f.order_id)     AS orders,\r\n",
        "       ROUND(SUM(f.gross_revenue), 2) AS gmv,\r\n",
        "       ROUND(AVG(f.delivery_days), 1) AS avg_delivery_days\r\n",
        "FROM ecom_dev.gold.fct_order_items f\r\n",
        "JOIN ecom_dev.gold.dim_customer c ON f.customer_sk = c.customer_sk\r\n",
        "GROUP BY c.customer_state\r\n",
        "ORDER BY gmv DESC;"
      ]
    },
    {
      "name": "935365be",
      "displayName": "seller_scorecard",
      "queryLines": [
        "SELECT seller_id, seller_city, seller_state, line_items, gmv,\r\n",
        "       avg_delivery_days, late_pct, avg_review_score\r\n",
        "FROM ecom_dev.gold.mart_seller_scorecard\r\n",
        "WHERE line_items >= 100\r\n",
        "ORDER BY late_pct DESC\r\n",
        "LIMIT 20;"
      ]
    }
  ],
